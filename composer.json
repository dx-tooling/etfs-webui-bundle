{
    "name": "enterprise-tooling-for-symfony/webui-bundle",
    "minimum-stability": "beta",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "symfony/dependency-injection": "7.4.*",
        "symfony/config": "7.4.*",
        "symfony/ux-live-component": "^v2.31",
        "symfony/asset-mapper": "7.4.*",
        "symfony/asset": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/stimulus-bundle": "^v2.31",
        "symfony/ux-twig-component": "^v2.31"
    },
    "require-dev": {
        "erickskrauch/php-cs-fixer-custom-fixers": "^1.3",
        "friendsofphp/php-cs-fixer": "^v3.89",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^12.4",
        "doctrine/orm": "^3.5",
        "doctrine/dbal": "^4.3",
        "symfony/doctrine-bridge": "7.4.*",
        "symfony/uid": "7.4.*"
    },
    "suggest": {},
    "conflict": {},
    "autoload": {
        "psr-4": {
            "EnterpriseToolingForSymfony\\WebuiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EnterpriseToolingForSymfony\\WebuiBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "symfony": {
            "require": "7.4.*"
        }
    }
}
